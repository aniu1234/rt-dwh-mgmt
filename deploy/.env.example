# RT-DWH Management Platform - Environment Configuration
# Copy this file to .env and fill in the values

# MySQL
MYSQL_ROOT_PASSWORD=root123123
MYSQL_PASSWORD=root123123
DB_PASSWORD=root123123
DB_USERNAME=rtdwh_admin

# PostgreSQL
PG_USER=rtdwh_admin
PG_PASSWORD=rtdwh_admin

# JWT Secret (must be at least 256 bits / 32 characters)
JWT_SECRET=

# Encryption Key for datasource passwords (AES-256)
ENCRYPTION_KEY=

# Paimon JDBC Password
# The user must have privileges on rtdwh_paimon_meta. The default deployment
# user is created by the MySQL container and granted access by init-mysql.sql.
PAIMON_JDBC_USER=rtdwh_admin
PAIMON_JDBC_PASSWORD=root123123

# Doris ad-hoc query engine (FE MySQL protocol / HTTP endpoint)
DORIS_ENABLED=true
DORIS_USERNAME=root
DORIS_PASSWORD=
DORIS_CATALOG=rtdwh_paimon
DORIS_DATABASE=ods
DORIS_INITIALIZE_CATALOG=true
DORIS_CATALOG_INIT_RETRY_MS=30000
DORIS_WORKLOAD_GROUP=rtdwh_adhoc
DORIS_EXEC_MEM_LIMIT_BYTES=2147483648
QUERY_MAX_CONCURRENT_PER_USER=2

# Persisted system health monitor
HEALTH_MONITOR_ENABLED=true
HEALTH_MONITOR_INTERVAL_MS=60000
HEALTH_MONITOR_INITIAL_DELAY_MS=5000

# Data quality scheduler
QUALITY_SCHEDULE_ENABLED=true
QUALITY_SCHEDULE_INTERVAL_MS=3600000
QUALITY_SCHEDULE_INITIAL_DELAY_MS=60000

# Workflow dependency scheduler (promotes waiting instances when upstream runs succeed)
WORKFLOW_SCHEDULER_ENABLED=true
WORKFLOW_DEPENDENCY_CHECK_MS=10000
WORKFLOW_INITIAL_DELAY_MS=10000

# Grafana Admin Password
GRAFANA_ADMIN_PASSWORD=

# Enable demo user initialization (set to true for first-time setup only)
INIT_USERS_ENABLED=false
# Required when INIT_USERS_ENABLED=true (first deployment only)
INIT_ADMIN_PASSWORD=
INIT_DEV_PASSWORD=
INIT_GUEST_PASSWORD=

# Email (optional)
MAIL_HOST=
ALERT_EMAIL_RECIPIENTS=

# DingTalk / WeCom Webhooks (optional)
DINGTALK_WEBHOOK=
WECOM_WEBHOOK=
